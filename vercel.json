{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/missing-produce/panel", "destination": "/api/missing-produce-panel" },
    { "source": "/api/tts", "destination": "/api/tts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
