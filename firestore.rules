rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Parent account profile (keyed by Firebase Auth uid) - used by the
    // Google/email login flow. Only the signed-in owner may touch their own doc.
    match /families/{familyId} {
      allow get, create, update: if request.auth != null && request.auth.uid == familyId;
      allow delete: if false;
    }

    // Cross-device sync keyed by the random family code (8 chars from a
    // 32-symbol alphabet => ~1.1e12 combinations). The code itself acts as
    // the shared secret / capability token, so no Firebase Auth is required
    // here - but access is limited to the exact sub-documents the app uses,
    // `list` is never granted (so the collection can't be enumerated), and
    // writes are shape/size-validated to block junk-data or storage abuse.
    match /families/{familyId}/dailyTasks/{date} {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['tasks', 'updatedAt'])
        && request.resource.data.tasks is string
        && request.resource.data.tasks.size() < 200000
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    match /families/{familyId}/rewards/current {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['smileys', 'gifts', 'updatedAt'])
        && request.resource.data.smileys is string
        && request.resource.data.smileys.size() < 50000
        && request.resource.data.gifts is string
        && request.resource.data.gifts.size() < 50000
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // "Find my tablet" remote alarm command. Any device holding the family
    // code can read this (a tablet must react no matter which screen it's
    // showing - it isn't gated behind the parent PIN, which is a client-
    // side-only concept and isn't visible to Firestore). Writes are shape-
    // validated the same way as the other sub-documents; there is no
    // server-enforced distinction between "parent" and "child" here since
    // this app has no real per-user auth on the family-code sync path -
    // the Parent Dashboard UI is what keeps the trigger button out of the
    // child view.
    match /families/{familyId}/commands/findDevice {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['findDevice', 'startedAt', 'startedBy', 'volume'])
        && request.resource.data.findDevice is bool
        && (request.resource.data.startedAt == null || request.resource.data.startedAt is timestamp)
        && request.resource.data.startedBy is string
        && request.resource.data.startedBy.size() < 100
        && request.resource.data.volume is number
        && request.resource.data.volume >= 0
        && request.resource.data.volume <= 1;
      allow delete: if false;
    }

    // Everything else is denied by default.
  }
}
